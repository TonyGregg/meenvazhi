{
  "name": "meenvazhi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first INCOIS Potential Fishing Zone waypoints for fishermen",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "build:full": "npm run build && rm -rf dist/data && cp -R ../public-data dist/data",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "echo \"see tools/subset-fonts.py; run it by hand and commit the output\"",
    "test:e2e": "playwright test",
    "build:android": "npm run build:native && cap sync android",
    "apk:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "build:native": "tsc --build && BUILD_TARGET=native vite build",
    "build:ios": "npm run build:native && cap sync ios",
    "ios:open": "npm run build:ios && cap open ios",
    "build:e2e": "npm run build && rm -rf dist/data && mkdir -p dist/data && cp ../pipeline/tests/fixtures/golden/pfz-latest.json dist/data/"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "idb-keyval": "^6.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.33.5",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
