{
  // End-to-end tests straddle both worlds: the test body runs in Node, but the
  // callbacks passed to page.evaluate run in the browser and need DOM types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
